# 복사해서 .env.local로 쓴다 (Git에 올리지 않는다). 설명: docs/06_ARCHITECTURE.md 11장
NEXT_PUBLIC_SUPABASE_URL=https://<프로젝트ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon 또는 publishable 키>

# 아래는 AI 기능(3.10a~) 작업 때 채운다
# 공급자: 기본 google(Gemini). anthropic으로 바꾸면 Claude (docs/06_ARCHITECTURE.md 7.1)
AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_PROVIDER=anthropic일 때만
ANTHROPIC_API_KEY=
AI_MOCK=1
AI_DAILY_LIMIT=100
